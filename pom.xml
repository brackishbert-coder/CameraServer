<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>The</groupId>
  <artifactId>CameraServer</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Which platform's native libraries to bundle. javacv-platform used to bundle
         EVERY bytedeco library (opencv, ffmpeg, openblas, realsense, leptonica, ...)
         for EVERY platform (win/mac/linux-x86_64/arm64/ppc64le/android) -> a 671 MB
         jar. We use OpenCVFrameGrabber only, which needs just the OpenCV native stack
         (opencv + openblas + javacpp). Set this per-OS build to emit only that
         platform's natives: linux-x86_64 (default), windows-x86_64, macosx-x86_64,
         macosx-arm64, linux-arm64. -->
    <javacpp.platform>linux-x86_64</javacpp.platform>
  </properties>

  <dependencies>
    <!-- JavaCV wrapper classes only (OpenCVFrameGrabber, Java2DFrameConverter): the
         Java API, no native libraries. Natives come solely from opencv-platform below,
         filtered to ${javacpp.platform}. No absolute-path System.load anywhere. -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacv</artifactId>
      <version>1.5.10</version>
    </dependency>
    <!-- Just the OpenCV native stack (opencv + its openblas + javacpp), and only for
         ${javacpp.platform}. Excludes ffmpeg/realsense/leptonica/tesseract and every
         non-target platform, cutting the fat jar from 671 MB to ~160 MB. -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv-platform</artifactId>
      <version>4.9.0-1.5.10</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <!-- Runnable fat jar (all natives bundled) -> the artifact jpackage wraps. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>cam.WebcamServer</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
